[Unit]
Description=Enca's SGEN - generador de CSR y claves privadas
Documentation=file:///opt/opensslweb/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opensslweb
Group=opensslweb
EnvironmentFile=-/etc/opensslweb/opensslweb.env
WorkingDirectory=/opt/opensslweb
ExecStart=/usr/bin/python3 -I -B /opt/opensslweb/app/server.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# Sin registros de operaciones: la aplicación no escribe nada en stdout.
# stderr solo recibe el mensaje de arranque o un fallo fatal de arranque.
StandardOutput=null
StandardError=journal
SyslogIdentifier=opensslweb

# Nada de volcados de memoria (podrían contener claves privadas).
LimitCORE=0
UMask=0077

# Endurecimiento
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Permite escuchar en puertos <1024 (p. ej. 443) sin ser root.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
