# Configuración de Enca's SGEN (/etc/opensslweb/opensslweb.env)
# Tras modificarla: systemctl restart opensslweb
#
# Este fichero NO se sobrescribe en las actualizaciones.

# Dirección y puerto de escucha.
#   127.0.0.1 -> solo local (recomendado detrás de un proxy inverso con HTTPS)
#   0.0.0.0   -> todas las interfaces IPv4      ::  -> todas IPv4+IPv6
OPENSSLWEB_HOST=127.0.0.1
OPENSSLWEB_PORT=8080

# HTTPS directo (opcional). HTTPS es OBLIGATORIO para usar la web desde otra
# máquina: el navegador solo permite el cifrado de las comunicaciones
# (WebCrypto) en https:// o localhost. Actívalo aquí o en un proxy inverso. Los ficheros deben ser legibles por el grupo
# "opensslweb", p. ej. en /etc/opensslweb/tls/ con permisos 0640 root:opensslweb.
#OPENSSLWEB_TLS_CERT=/etc/opensslweb/tls/fullchain.pem
#OPENSSLWEB_TLS_KEY=/etc/opensslweb/tls/privkey.pem

# Número máximo de generaciones de claves simultáneas.
OPENSSLWEB_MAX_JOBS=4
