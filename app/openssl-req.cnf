# Configuración mínima y estática para "openssl req".
# No contiene datos de usuario: el sujeto y las extensiones se pasan
# como argumentos (-subj / -addext) tras validarlos.
openssl_conf = openssl_init

[openssl_init]

[req]
distinguished_name = req_dn
string_mask        = utf8only
utf8               = yes
prompt             = no

[req_dn]
